generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creador {
  id           String   @id @default(uuid())
  nombre       String
  usuario      String   @unique
  email        String   @unique
  passwordHash String
  rol          Rol      @default(USUARIO)
  bio          String?
  createdAt    DateTime @default(now())

  links        Link[]
  encuestas    Encuesta[]
  sorteos      Sorteo[]
  ruletas      Ruleta[]
  referidos    Referido[]
 
}

model Link {
  id         String   @id @default(uuid())
  titulo     String
  url        String
  orden      Int      @default(0)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  creador    Creador  @relation(fields: [creadorId], references: [id])
  creadorId  String
}
model Encuesta {
  id         String            @id @default(uuid())
  pregunta   String
  activa     Boolean           @default(true)
  createdAt  DateTime          @default(now())

  creador    Creador           @relation(fields: [creadorId], references: [id])
  creadorId  String

  opciones   OpcionEncuesta[]
}

model OpcionEncuesta {
  id          String   @id @default(uuid()) 
  texto       String
  votos       Int      @default(0)
  encuestaId  String
  encuesta    Encuesta @relation(fields: [encuestaId], references: [id])

}
model Sorteo {
  id               String          @id @default(uuid())
  titulo           String
  premio           String
  limiteGanadores  Int
  contador         Int             @default(0)
  activo           Boolean         @default(true)
  createdAt        DateTime        @default(now())

  creador          Creador         @relation(fields: [creadorId], references: [id])
  creadorId        String

  ganadores        SorteoGanador[]
}

model SorteoGanador {
  id          String   @id @default(uuid())
  codigo      String
  createdAt   DateTime @default(now())

  sorteo      Sorteo   @relation(fields: [sorteoId], references: [id])
  sorteoId    String
}
model Ruleta {
  id         String     @id @default(uuid())
  titulo     String
  activa     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  creador    Creador    @relation(fields: [creadorId], references: [id])
  creadorId  String

  segmentos  Segmento[]
}

model Segmento {
  id        String  @id @default(uuid())
  texto     String
  peso      Int     @default(1)

  ruleta    Ruleta  @relation(fields: [ruletaId], references: [id])
  ruletaId  String
}
model Referido {
  id          String   @id @default(uuid())
  nombre      String
  enlace      String
  mensaje     String?
  destacado   Boolean  @default(false)
  createdAt   DateTime @default(now())

  creador     Creador  @relation(fields: [creadorId], references: [id])
  creadorId   String
}
enum Rol {
  ADMIN
  USUARIO
}